# --- Database ---
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=software_factory
DATABASE_URL=postgresql://factory:factory@localhost:5432/software_factory

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- MinIO / Storage ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=software-factory-artifacts

# --- Auth (OAuth2 / OIDC / JWT) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the redirect URI registered with the IdP.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
# Where the API redirects back to after a successful sign-in (apps/web origin).
WEB_ORIGIN=http://localhost:5173

# --- Demand source ---
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_TOKEN=

# --- Code repository ---
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# --- LLM providers ---
LLM_PROVIDER=chatgpt
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- App ---
PORT=3000
NODE_ENV=development
# Override only if apps/api/dist ends up at a different depth from the repo
# root than usual (e.g. some container build layouts) — see workspaces.service.ts.
# WORKSPACE_ROOT=/absolute/path/to/workspace
