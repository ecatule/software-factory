# --- Database ---
POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=software_factory
DATABASE_URL=postgresql://factory:factory@localhost:5432/software_factory

# --- Redis / Queue ---
REDIS_URL=redis://localhost:6379

# --- MinIO / Storage ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=software-factory-artifacts

# --- Auth (OAuth2 / OIDC / JWT) ---
# GET /auth/callback only accepts an OIDC email claim that already exists as
# a User row (it never auto-creates one) — this must match the email your
# OIDC provider will authenticate, e.g. your own Google/Auth0 account.
SEED_ADMIN_EMAIL=admin@software-factory.local
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Must match the redirect URI registered with the IdP.
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too
JWT_REFRESH_EXPIRES_IN=7d
# Where the API redirects back to after a successful sign-in (apps/web origin).
WEB_ORIGIN=http://localhost:5173

# --- Demand source ---
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_TOKEN=

# --- Code repository ---
GITHUB_API_URL=https://api.github.com
GITHUB_TOKEN=

# --- LLM providers ---
LLM_PROVIDER=chatgpt
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- SDD pipeline ("Modo B" — headless Claude Code drives every Spec Kit stage) ---
# Both CLIs must be installed and on PATH for the process running the BullMQ worker.
# SDD_SPECIFY_CLI_COMMAND=specify
# SDD_CLI_COMMAND=claude
# Only used when no ProviderConfiguration row (Settings screen) sets a model for the
# project/stage — leave unset to let `claude` use its own default.
# SDD_DEFAULT_MODEL=claude-sonnet-5
# Defensive cap so a hung `claude`/`specify` subprocess never blocks the worker forever.
# SDD_CLI_TIMEOUT_MS=600000
#
# Auth profiles: NEVER put a credential in ProviderConfiguration.settings (rejected by
# secret-pattern.guard.ts) — only a non-secret profile label (e.g. "default") is stored
# there, via the Settings screen's "Auth profile" field. The actual credential always
# lives here, as `SDD_AUTH_PROFILE_<KEY>_...` (KEY = the label, upper-cased):
#   - OAUTH_TOKEN: from `claude setup-token` — the intended, non-interactive way to use a
#     personal Claude Pro/Max subscription for an unattended worker, no metered billing.
#   - API_KEY: a console.anthropic.com key, if you'd rather bill per token.
#   - CONFIG_DIR: optional — isolates where `claude` stores credentials for this profile
#     (CLAUDE_CONFIG_DIR), only needed if you run more than one profile on the same host.
# To add a different account later: run `claude setup-token` logged into that account,
# add its 3 variables under a new <KEY>, and pick that key in Settings — no code change.
# SDD_AUTH_PROFILE_DEFAULT_OAUTH_TOKEN=

# --- App ---
PORT=3000
NODE_ENV=development
# Override only if apps/api/dist ends up at a different depth from the repo
# root than usual (e.g. some container build layouts) — see workspaces.service.ts.
# WORKSPACE_ROOT=/absolute/path/to/workspace
