# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Env
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Prisma
apps/api/prisma/migrations/dev/

# Coverage
coverage/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp

# Demand workspaces (runtime data, not source)
workspace/*
!workspace/.gitkeep

# Per-project production/homologation URLs used by the pre-implement safety
# gate (production-reference.guard.ts) — deliberately never committed and
# never stored in Postgres; populated manually on each server.
project-environments/*
!project-environments/.gitkeep
